<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3 class="mb-4">
            <i class="fas fa-user-circle"></i> My Profile
        </h3>

        <div class="card listing-card">
            <div class="card-body">
                <div class="text-center mb-4">
                    <div class="profile-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <h5 class="mt-3"><%= user.username %></h5>
                    <% if (user.isVerified) { %>
                        <span class="badge bg-success">
                            <i class="fas fa-check-circle"></i> Verified
                        </span>
                    <% } else { %>
                        <span class="badge bg-warning text-dark">
                            <i class="fas fa-exclamation-circle"></i> Not Verified
                        </span>
                    <% } %>
                </div>

                <hr>

                <div class="row mt-4 mb-4">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <div class="info-box">
                            <label class="form-label text-muted">
                                <i class="fas fa-envelope"></i> Email
                            </label>
                            <div class="form-control-plaintext">
                                <%= user.email %>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-box">
                            <label class="form-label text-muted">
                                <i class="fas fa-heart"></i> Wishlist
                            </label>
                            <div class="form-control-plaintext">
                                <%= user.wishlist.length %> listings saved
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 mb-3 d-flex gap-3 justify-content-center">
                    <a href="/wishlist" class="btn btn-outline-danger px-4 py-2">
                        <i class="fas fa-heart"></i> My Wishlist
                    </a>
                    <a href="/listings" class="btn btn-outline-dark px-4 py-2">
                        <i class="fas fa-home"></i> Explore
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .profile-avatar {
        width: 80px;
        height: 80px;
        background-color: #fe424d;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
    }

    .info-box {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 8px;
    }

    .listing-card {
        border: none;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        border-radius: 12px;
    }

    .form-control-plaintext {
        font-size: 1.1rem;
        font-weight: 500;
    }

    .badge {
        font-size: 0.85rem;
        padding: 0.5rem 1rem;
    }
</style>