<% layout("/layouts/boilerplate") %>

    <body>
        <style>
            @media (min-width: 601px) {
                .filters-button { display: none !important; }
                #filters { display: flex; flex-wrap: nowrap; overflow-x: visible; gap: 2rem; align-items: center; }
            }
            @media (max-width: 600px) {
                .filters-button { display: block !important; }
                #filters { display: flex; overflow-x: auto; white-space: nowrap; gap: 2rem; align-items: center; }
                #filters::-webkit-scrollbar { display: none; }
            }
            .filter { text-align: center; margin-top: 2rem; opacity: 0.7; min-width: 70px; }
            .filter:hover { opacity: 1; cursor: pointer; }
            .filter p { font-size: 0.8rem; }
            .tax-info { display: none; }
            .tax-toggle { border: 1px solid black; border-radius: 1rem; height: 3.25rem; padding: 0.3rem; display: flex; justify-content: center; align-items: center; }
        </style>

        

        <div class="collapse show" id="filterCollapse">
            <div id="filters">
                <a href="/listings?category=Trending" class="filter">
                    <div><i class="fa-solid fa-fire"></i></div><p>Trending</p>
                </a>
                <a href="/listings?category=Rooms" class="filter">
                    <div><i class="fa-solid fa-bed"></i></div><p>Rooms</p>
                </a>
                <a href="/listings?category=Iconic%20Cities" class="filter">
                    <div><i class="fa-solid fa-mountain-city"></i></div><p>Iconic Cities</p>
                </a>
                <a href="/listings?category=Mountains" class="filter">
                    <div><i class="fa-solid fa-mountain"></i></div><p>Mountains</p>
                </a>
                <a href="/listings?category=Castles" class="filter">
                    <div><i class="fa-brands fa-fort-awesome"></i></div><p>Castles</p>
                </a>
                <div class="filter">
                    <div><i class="fa-solid fa-person-swimming"></i></div><p>Amazing Pools</p>
                </div>
                <div class="filter">
                    <div><i class="fa-solid fa-campground"></i></div><p>Camping</p>
                </div>
                <div class="filter">
                    <div><i class="fa-solid fa-cow"></i></div><p>Farms</p>
                </div>
                <div class="filter">
                    <div><i class="fa-solid fa-snowflake"></i></div><p>Arctic</p>
                </div>
                <div class="tax-toggle mt-3">
                    <div class="form-check-reverse form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                        <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
            <% for(let listing of allListings) { %>
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card col listing-card">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height:20rem" loading="lazy">
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <p class="card-text">
                                <b><%= listing.title %></b><br>
                                &#8377;<%= listing.price.toLocaleString("en-IN") %> /night
                                <i class="tax-info"> &nbsp; &nbsp; +18% GST </i>
                            </p>
                        </div>
                    </div>
                </a>
            <% } %>
        </div>

        <% const tp = typeof totalPages !== 'undefined' ? totalPages : 1; %>
        <% if (tp > 1) { %>
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="?page=<%= currentPage - 1 %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>">Previous</a>
                </li>
                <% for(let i = 1; i <= tp; i++) { %>
                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= i %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>"><%= i %></a>
                    </li>
                <% } %>
                <li class="page-item <%= currentPage === tp ? 'disabled' : '' %>">
                    <a class="page-link" href="?page=<%= currentPage + 1 %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>">Next</a>
                </li>
            </ul>
        </nav>
        <% } %>
    </body>

    <script>
        let taxSwitch = document.getElementById("switchCheckDefault");
        taxSwitch.addEventListener("click", () => {
            let taxInfo = document.getElementsByClassName("tax-info");
            for (let info of taxInfo) {
                if (info.style.display === "" || info.style.display === "none") {
                    info.style.display = "inline";
                } else {
                    info.style.display = "none";
                }
            }
        });
    </script>